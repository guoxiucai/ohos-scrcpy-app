*.webp      binary
*.zip       binary
*.tar.gz    binary
*.dmg       binary
*.hap       binary
*.hsp       binary
*.exe       binary
*.dll       binary
*.so        binary
*.dylib     binary
*.framework binary
*.a         binary
*.lib       binary
*.pak       binary
*.pdb       binary
*.cer       binary
*.p12       binary
*.keystore  binary
*.jks       binary
*.ttf       binary
*.otf       binary
*.woff      binary
